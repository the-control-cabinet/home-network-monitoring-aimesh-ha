{# All trackers (any integration) for one MAC, with every attribute. Lower-case MAC. #}
{%- set mac = 'aa:bb:cc:dd:ee:ff' %}
{%- for s in states.device_tracker if (s.attributes.mac | default('')) | lower == mac %}
{{ s.entity_id }}
{%- for k, v in s.attributes.items() %}
  {{ k }}: {{ v }}
{%- endfor %}
{%- endfor %}
